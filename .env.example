# Copy to `.env` and fill in before building the APK.
#
#   cp .env.example .env
#
# Every value is optional — the app degrades gracefully without them:
#   • No Supabase  -> local guest mode, login screen skipped
#   • No API URL   -> curated fallback dataset, with a banner saying so

# --- Discovery API (server/) ------------------------------------------------
VITE_API_BASE_URL=https://startvate-api.YOUR-SUBDOMAIN.workers.dev

# --- Supabase ---------------------------------------------------------------
# See supabase/README.md for full setup, including Google OAuth.
#
# Use the ANON (publishable) key only. It is public by design and safe to ship
# because Row Level Security governs every table. NEVER put the service_role
# key here — it bypasses RLS and would expose every user's data.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
