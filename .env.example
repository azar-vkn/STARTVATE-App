# Copy to `.env` and fill in before building the APK.
#
#   cp .env.example .env
#
# Behaviour when a value is missing:
#   • No Supabase  -> local guest mode; login screen skipped, data stays on device
#   • No API URL   -> search and Ask AI report they are not configured.
#                     There is no fallback data; the app never invents results.

# --- Discovery API (server/) ------------------------------------------------
VITE_API_BASE_URL=https://startvate-api.YOUR-SUBDOMAIN.workers.dev

# --- Supabase ---------------------------------------------------------------
# See supabase/README.md for full setup, including Google OAuth.
#
# Use the PUBLISHABLE key. Supabase shows it as either the legacy `anon` JWT
# (eyJ...) or the newer `sb_publishable_...` format — supabase-js accepts both,
# and this variable takes whichever your project displays.
#
# It is public by design and safe to ship because Row Level Security governs
# every table. NEVER put the service_role / secret key here — it bypasses RLS
# and would expose every user's data to anyone who unzips the APK.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
