# SIGNING SECRETS — never commit these.
# Losing the keystore means you can never update the app on Play Store,
# so back it up somewhere safe and private.
android/keystore.properties
*.keystore
*.jks

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/

# Logs
npm-debug.log*
yarn-error.log*
